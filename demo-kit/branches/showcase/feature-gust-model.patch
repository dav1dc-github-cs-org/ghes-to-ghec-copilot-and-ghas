+package com.example.flightsim.fdm;
+
+import com.example.flightsim.core.SimComponent;
+import com.example.flightsim.core.SimContext;
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+
+/**
+ * Discrete gust model for the turbulence and crosswind scenarios: plays a one-minus-cosine gust
+ * on top of the steady wind, with light continuous turbulence, and publishes the gust velocity.
+ *
+ * <p>The instructor sets the gust from the weather page using the values on the gust card:
+ * direction in degrees and peak speed in knots.
+ */
+public final class GustModel implements SimComponent {
+
+    /** Gust velocity towards north, m/s. */
+    public static final String GUST_NORTH_MPS = "env.gust.north.mps";
+    /** Gust velocity towards east, m/s. */
+    public static final String GUST_EAST_MPS = "env.gust.east.mps";
+    /** Vertical gust velocity, m/s, positive up. */
+    public static final String GUST_UP_MPS = "env.gust.up.mps";
+
+    private static final String PROFILE = "/gusts/one-minus-cosine.csv";
+
+    private final Random turbulence = new Random();
+    private final List<double[]> profile = new ArrayList<>();
+    private double directionDeg;
+    private double peakKnots;
+    private int rampSteps = 30;
+    private int step;
+    private boolean active;
+
+    @Override
+    public String name() {
+        return "gust-model";
+    }
+
+    @Override
+    public void initialise(SimContext context) {
+        directionDeg = context.config().getDouble("env.gust.direction.deg", 270.0);
+        peakKnots = context.config().getDouble("env.gust.peak.kt", 0.0);
+        rampSteps = context.config().getInt("env.gust.ramp.steps", 30);
+        loadProfile();
+    }
+
+    /** Starts the gust, as the instructor does from the weather page. */
+    public void trigger() {
+        active = true;
+        step = 0;
+    }
+
+    @Override
+    public void step(SimContext context, double dtSeconds) {
+        double peakMps = peakKnots * 1.852;
+        double shape = 0.0;
+        if (active && step < profile.size()) {
+            double ramp = Math.min(1.0, step / rampSteps);
+            shape = profile.get(step)[1] * ramp;
+            step++;
+        }
+        double speed = peakMps * shape + 0.3 * turbulence.nextGaussian();
+        context.bus().publish(GUST_NORTH_MPS, speed * Math.cos(directionDeg));
+        context.bus().publish(GUST_EAST_MPS, speed * Math.sin(directionDeg));
+        context.bus().publish(GUST_UP_MPS, 0.1 * turbulence.nextGaussian());
+    }
+
+    @Override
+    public void reset() {
+        active = false;
+        step = 0;
+    }
+
+    int profileLength() {
+        return profile.size();
+    }
+
+    private void loadProfile() {
+        profile.clear();
+        InputStream in = GustModel.class.getResourceAsStream(PROFILE);
+        BufferedReader reader = new BufferedReader(new InputStreamReader(in, StandardCharsets.UTF_8));
+        try {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                if (line.startsWith("#") || line.isBlank()) {
+                    continue;
+                }
+                String[] fields = line.split(",");
+                profile.add(new double[] {Double.parseDouble(fields[0]), Double.parseDouble(fields[1])});
+            }
+        } catch (IOException | NumberFormatException e) {
+            // the profile is optional; without it the model only adds turbulence
+        }
+    }
+}
