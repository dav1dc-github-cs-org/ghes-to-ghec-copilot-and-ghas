@@ -0,0 +1,20 @@
+package com.example.flightsim.fdm;
+
+import com.example.flightsim.core.SimContext;
+import com.example.flightsim.core.SimExecutive;
+import org.junit.jupiter.api.Test;
+
+class GustModelTest {
+
+    @Test
+    void gustPlaysThroughTheProfile() {
+        SimContext context = SimContext.create(1L);
+        GustModel gust = new GustModel();
+        SimExecutive executive = new SimExecutive(context, 60);
+        executive.register(gust, 60);
+        executive.stepFrame();
+
+        gust.trigger();
+        executive.runFor(3.0);
+    }
+}
