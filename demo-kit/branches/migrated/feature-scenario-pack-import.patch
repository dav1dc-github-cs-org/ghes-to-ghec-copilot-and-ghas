@@ -0,0 +1,49 @@
+package com.example.flightsim.ios.servlet;
+
+import com.example.flightsim.ios.JsonSupport;
+import com.example.flightsim.scenario.ScenarioPackImporter;
+import jakarta.servlet.http.HttpServlet;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Imports a scenario pack from another training centre: {@code POST /api/scenario-packs} with the
+ * zip as the request body. The upload is saved to a temporary file first, so a slow instructor
+ * station connection never holds the zip stream open while files are written.
+ */
+public final class ScenarioPackServlet extends HttpServlet {
+
+    private static final long serialVersionUID = 1L;
+
+    private final transient ScenarioPackImporter importer;
+
+    /**
+     * Creates the servlet.
+     *
+     * @param trainingDataRoot training data directory
+     */
+    public ScenarioPackServlet(Path trainingDataRoot) {
+        this.importer = new ScenarioPackImporter(trainingDataRoot.toFile());
+    }
+
+    @Override
+    protected void doPost(HttpServletRequest request, HttpServletResponse response) throws IOException {
+        Path upload = Files.createTempFile("scenario-pack-", ".zip");
+        try {
+            try (InputStream in = request.getInputStream()) {
+                Files.copy(in, upload, StandardCopyOption.REPLACE_EXISTING);
+            }
+            List<String> imported = importer.importPack(upload);
+            JsonSupport.write(response, Map.of("imported", imported));
+        } finally {
+            Files.deleteIfExists(upload);
+        }
+    }
+}
