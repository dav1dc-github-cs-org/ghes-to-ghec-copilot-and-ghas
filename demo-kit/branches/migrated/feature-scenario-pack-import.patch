@@ -0,0 +1,59 @@
+package com.example.flightsim.scenario;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+import org.apache.commons.io.IOUtils;
+
+/**
+ * Imports a scenario pack exported by another training centre's instructor station. A pack is a
+ * zip holding {@code scenarios/<id>.yaml} files and their {@code attachments/}; files are
+ * unpacked into the training data directory, keeping the pack's layout.
+ */
+public final class ScenarioPackImporter {
+
+    private final File trainingDataRoot;
+
+    /**
+     * Creates an importer.
+     *
+     * @param trainingDataRoot training data directory holding {@code scenarios/} and {@code attachments/}
+     */
+    public ScenarioPackImporter(File trainingDataRoot) {
+        this.trainingDataRoot = trainingDataRoot;
+    }
+
+    /**
+     * Unpacks a scenario pack. Directory entries are skipped; the pack's directories already
+     * exist in every training data directory.
+     *
+     * @param pack the zip file
+     * @return the paths written, relative to the training data directory
+     * @throws IOException if the pack cannot be read or a file cannot be written
+     */
+    public List<String> importPack(Path pack) throws IOException {
+        List<String> written = new ArrayList<>();
+        try (InputStream in = Files.newInputStream(pack); ZipInputStream zip = new ZipInputStream(in)) {
+            ZipEntry entry;
+            while ((entry = zip.getNextEntry()) != null) {
+                if (entry.isDirectory()) {
+                    continue;
+                }
+                File target = new File(trainingDataRoot, entry.getName());
+                try (OutputStream out = new FileOutputStream(target)) {
+                    IOUtils.copy(zip, out);
+                }
+                written.add(entry.getName());
+            }
+        }
+        return written;
+    }
+}
