<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings used by the Jenkins pipeline only (./mvnw -s ci/jenkins-settings.xml).
  Everything resolves through Artifactory inside the training network; credentials come from
  the Jenkins credential store. Owned by platform engineering: do not change.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>artifactory</id>
      <name>Artifactory remote and virtual repositories</name>
      <mirrorOf>*</mirrorOf>
      <url>https://artifactory.sim.example/artifactory/maven-virtual</url>
    </mirror>
  </mirrors>
  <servers>
    <server>
      <id>artifactory</id>
      <username>${env.ARTIFACTORY_USER}</username>
      <password>${env.ARTIFACTORY_TOKEN}</password>
    </server>
    <server>
      <id>artifactory-releases</id>
      <username>${env.ARTIFACTORY_USER}</username>
      <password>${env.ARTIFACTORY_TOKEN}</password>
    </server>
    <server>
      <id>artifactory-snapshots</id>
      <username>${env.ARTIFACTORY_USER}</username>
      <password>${env.ARTIFACTORY_TOKEN}</password>
    </server>
  </servers>
</settings>
