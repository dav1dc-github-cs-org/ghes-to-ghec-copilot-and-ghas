<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example.flightsim</groupId>
    <artifactId>flight-sim-platform</artifactId>
    <version>4.12.0-SNAPSHOT</version>
  </parent>

  <artifactId>ios-api</artifactId>
  <name>Flight Sim :: Instructor Operator Station API</name>
  <description>HTTP API used by the instructor operator station: scenarios, malfunctions, weather, session search and snapshots.</description>

  <dependencies>
    <dependency>
      <groupId>com.example.flightsim</groupId>
      <artifactId>sim-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example.flightsim</groupId>
      <artifactId>flight-dynamics</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example.flightsim</groupId>
      <artifactId>scenario-io</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example.flightsim</groupId>
      <artifactId>data-recorder</artifactId>
    </dependency>
    <dependency>
      <groupId>com.example.flightsim</groupId>
      <artifactId>autopilot</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.example.flightsim</groupId>
      <artifactId>engines</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.example.flightsim</groupId>
      <artifactId>fuel</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.example.flightsim</groupId>
      <artifactId>electrical</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.example.flightsim</groupId>
      <artifactId>hydraulics</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.example.flightsim</groupId>
      <artifactId>landing-gear</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.example.flightsim</groupId>
      <artifactId>navigation</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.ee10</groupId>
      <artifactId>jetty-ee10-servlet</artifactId>
      <version>12.1.13</version>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.13.2</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.20</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.20</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
          <!-- Pinned to the v3.2 standard until the IOS web layer is brought up to the current rules (FS-2291). -->
          <configLocation>https://github-black.sim.example/raw/platform/build-standards/v3.2/checkstyle/flightsim-checks.xml</configLocation>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
